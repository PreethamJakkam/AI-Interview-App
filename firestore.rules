rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== Users Collection ==========
    // Users can read/write their own document
    // Leaderboard: anyone authenticated can read all user profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // ========== Interviews Collection ==========
    // Users can create interviews and read their own
    match /interviews/{interviewId} {
      allow read: if request.auth != null && resource.data.odiserId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.odiserId == request.auth.uid;
    }

    // ========== Practice Sessions Collection ==========
    // Users can create sessions and read their own
    match /practice_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.odiserId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.odiserId == request.auth.uid;
    }
  }
}
